<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
(function(){
"use strict";

const form = document.getElementById("personaForm");
const resultPanel = document.getElementById("resultPanel");
const resultText = document.getElementById("resultText");
const copyButton = document.getElementById("copyButton");
const selectButton = document.getElementById("selectButton");
const resetButton = document.getElementById("resetButton");
const toast = document.getElementById("toast");
let toastTimer;

function showToast(message){
clearTimeout(toastTimer);
toast.textContent = message;
toast.classList.add("show");
toastTimer = setTimeout(function(){
toast.classList.remove("show");
}, 2200);
}

function selectedRadio(name){
const item = form.querySelector('input[name="' + name + '"]:checked');
return item ? item.value : "";
}

function checkedValues(containerId){
return Array.from(
document.querySelectorAll("#" + containerId + ' input[type="checkbox"]:checked')
).map(function(input){
return input.value;
});
}

function clean(value){
return String(value || "").trim();
}

function radioValueWithCustom(name, customId){
const selected = form.querySelector('input[name="' + name + '"]:checked');
if(!selected) return "";

if(selected.dataset.customTarget){
const custom = clean(document.getElementById(customId).value);
return custom || selected.value;
}
return selected.value;
}

function updateCustomInputs(name){
const radios = form.querySelectorAll('input[name="' + name + '"]');
radios.forEach(function(radio){
if(!radio.dataset.customTarget) return;
const target = document.getElementById(radio.dataset.customTarget);
const visible = radio.checked;
target.style.display = visible ? "block" : "none";
if(!visible) target.value = "";
});
}

["primaryGender","identity","scent"].forEach(function(name){
form.querySelectorAll('input[name="' + name + '"]').forEach(function(radio){
radio.addEventListener("change", function(){
updateCustomInputs(name);
});
});
});

form.addEventListener("submit", function(event){
event.preventDefault();

const personName = clean(document.getElementById("personName").value);
const nickname = clean(document.getElementById("nickname").value);
const primaryGender = radioValueWithCustom("primaryGender","primaryCustom");
const secondaryGender = selectedRadio("secondaryGender");
const identity = radioValueWithCustom("identity","identityCustom");
const scent = radioValueWithCustom("scent","scentCustom");
const preferences = checkedValues("preferenceOptions");
const detailPreference = clean(document.getElementById("detailPreference").value);
const charges = checkedValues("chargeOptions");
const attitude = selectedRadio("attitude");
const etc = clean(document.getElementById("etc").value);

if(!personName){
showToast("성함을 입력하십시오.");
document.getElementById("personName").focus();
return;
}
if(!primaryGender){
showToast("제1성별을 선택하거나 입력하십시오.");
return;
}
if(!secondaryGender){
showToast("제2성별을 선택하십시오.");
return;
}
if(!identity){
showToast("신분을 선택하거나 입력하십시오.");
return;
}

const serialNumber = identity === "교육생" ? "111번" : "해당 없음";
const issueDate = new Date().toLocaleDateString("ko-KR",{
year:"numeric",
month:"2-digit",
day:"2-digit"
});

const documentText =
`[국립 제7오메가교육소 방문·배치 사전등록서]

■ 기본 인적사항
성함: ${personName}
별명: ${nickname || "미기재"}
수번: ${serialNumber}
제1성별: ${primaryGender}
제2성별: ${secondaryGender}
신분: ${identity}

■ 형질 및 성향
체향: ${scent || "미기재"}
성적 취향: ${preferences.length ? preferences.join(" / ") : "미기재"}
세부 취향: ${detailPreference || "미기재"}

■ 교육 및 관리 참고사항
죄명: ${charges.length ? charges.join(" / ") : "해당 없음 또는 미기재"}
태도: ${attitude || "미기재"}
기타: ${etc || "미기재"}

■ 행정 처리
작성일: ${issueDate}
처리기관: 국립 제7오메가교육소
문서상태: 방문·배치 사전검토 대기

※ 본 문서는 견학, 면회, 근무 또는 교육 배치를 위한 사전 참고자료입니다.
※ 교육생으로 분류된 신청인의 수번은 111번으로 임시 지정됩니다.
※ 최종 신분과 관리등급은 현장 기초평가 후 변경될 수 있습니다.`;

resultText.value = documentText;
resultPanel.classList.add("open");
resultPanel.scrollIntoView({behavior:"smooth",block:"center"});
showToast("사전등록서가 생성되었습니다.");
});

copyButton.addEventListener("click", async function(){
if(!resultText.value){
showToast("먼저 신청서를 생성하십시오.");
return;
}

try{
await navigator.clipboard.writeText(resultText.value);
showToast("신청서 내용을 복사했습니다.");
}catch(error){
resultText.focus();
resultText.select();
resultText.setSelectionRange(0, resultText.value.length);

try{
const copied = document.execCommand("copy");
showToast(copied ? "신청서 내용을 복사했습니다." : "전체 선택했습니다. 직접 복사하십시오.");
}catch(fallbackError){
showToast("전체 선택했습니다. 직접 복사하십시오.");
}
}
});

selectButton.addEventListener("click", function(){
if(!resultText.value){
showToast("먼저 신청서를 생성하십시오.");
return;
}
resultText.focus();
resultText.select();
resultText.setSelectionRange(0, resultText.value.length);
showToast("신청서 전체를 선택했습니다.");
});

resetButton.addEventListener("click", function(){
const confirmed = window.confirm("작성한 항목과 생성 결과를 모두 초기화하시겠습니까?");
if(!confirmed) return;

form.reset();
["primaryCustom","identityCustom","scentCustom"].forEach(function(id){
const input = document.getElementById(id);
input.value = "";
input.style.display = "none";
});
resultText.value = "";
resultPanel.classList.remove("open");
showToast("신청서를 초기화했습니다.");
});
})();
</script>
