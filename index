<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="국립 제7오메가교육소 공식 홈페이지">
<meta name="theme-color" content="#0b2744">
<title>국립 제7오메가교육소</title>
<style>
:root{
--navy:#0b2744;
--navy2:#102e4a;
--navy3:#173f65;
--blue:#285b82;
--pale:#eaf1f7;
--paper:#ffffff;
--bg:#eef2f5;
--line:#d3dce4;
--text:#1d2730;
--muted:#64727d;
--red:#8e3438;
--gold:#b39a62;
--shadow:0 18px 60px rgba(12,39,68,.13);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
margin:0;
background:#dfe5ea;
color:var(--text);
font-family:Pretendard,"Noto Sans KR","Apple SD Gothic Neo",Arial,sans-serif;
line-height:1.65;
word-break:keep-all;
}
button,input,textarea,select{font:inherit}
button,a{-webkit-tap-highlight-color:transparent}
a{color:inherit}
.site{
width:100%;
max-width:1180px;
min-height:100vh;
margin:0 auto;
overflow:hidden;
background:#f4f6f8;
box-shadow:var(--shadow);
}
.topbar{
padding:7px clamp(16px,5vw,58px);
display:flex;
justify-content:space-between;
gap:14px;
background:#071b2f;
color:rgba(255,255,255,.64);
font-size:11px;
}
.header{
position:sticky;
top:0;
z-index:50;
display:flex;
align-items:center;
justify-content:space-between;
gap:20px;
padding:13px clamp(16px,5vw,58px);
background:rgba(11,39,68,.97);
border-bottom:1px solid rgba(255,255,255,.16);
color:#fff;
backdrop-filter:blur(12px);
}
.brand{
display:flex;
align-items:center;
gap:11px;
flex:0 0 auto;
text-decoration:none;
}
.seal{
width:42px;
height:42px;
display:flex;
align-items:center;
justify-content:center;
border:3px double rgba(255,255,255,.75);
border-radius:50%;
background:#15395f;
font-size:17px;
font-weight:900;
}
.brand-en{
color:rgba(255,255,255,.55);
font-size:8px;
font-weight:900;
letter-spacing:.13em;
}
.brand-ko{
font-size:16px;
font-weight:900;
}
.nav{
display:flex;
align-items:center;
justify-content:flex-end;
gap:4px;
overflow-x:auto;
scrollbar-width:none;
}
.nav::-webkit-scrollbar{display:none}
.nav a{
padding:8px 9px;
border-radius:3px;
color:rgba(255,255,255,.75);
font-size:11px;
font-weight:800;
text-decoration:none;
white-space:nowrap;
}
.nav a:hover,.nav a:focus{
background:rgba(255,255,255,.12);
color:#fff;
outline:none;
}
.hero{
position:relative;
min-height:590px;
display:flex;
align-items:flex-end;
overflow:hidden;
background:var(--navy);
}
.hero>img{
position:absolute;
inset:0;
width:100%;
height:100%;
object-fit:cover;
object-position:center top;
filter:saturate(.55) contrast(1.05);
opacity:.64;
}
.hero-shade{
position:absolute;
inset:0;
background:linear-gradient(180deg,rgba(7,26,45,.04),rgba(7,26,45,.57) 48%,rgba(7,26,45,.98));
}
.hero-content{
position:relative;
width:100%;
padding:155px clamp(22px,6vw,72px) 62px;
color:#fff;
}
.eyebrow{
color:#2c6090;
font-size:11px;
font-weight:900;
letter-spacing:.22em;
}
.eyebrow.light{color:#a5c2d7}
.hero-badge{
display:inline-block;
padding:7px 12px;
border:1px solid rgba(255,255,255,.42);
background:rgba(5,20,34,.42);
font-size:11px;
font-weight:900;
}
.hero h1{
max-width:800px;
margin:17px 0 0;
font-family:Georgia,"Noto Serif KR",serif;
font-size:clamp(39px,8vw,72px);
line-height:1.12;
letter-spacing:-.055em;
text-shadow:0 4px 18px rgba(0,0,0,.36);
}
.gold-line{
width:60px;
height:3px;
margin:26px 0 20px;
background:#c3a45b;
}
.hero p{
max-width:680px;
margin:0;
color:rgba(255,255,255,.8);
font-size:clamp(14px,2.4vw,17px);
line-height:1.9;
}
.quick{
display:grid;
grid-template-columns:repeat(4,1fr);
background:#fff;
border-bottom:1px solid var(--line);
}
.quick a{
padding:18px 12px;
text-align:center;
text-decoration:none;
border-right:1px solid var(--line);
color:var(--navy2);
font-size:12px;
font-weight:900;
}
.quick a:last-child{border-right:0}
.quick a:hover{background:var(--pale)}
.notice{
padding:14px clamp(20px,5vw,58px);
display:flex;
align-items:flex-start;
gap:12px;
background:#fff4f4;
border-bottom:1px solid #e4bfc1;
color:#61363a;
font-size:12px;
}
.notice b{color:#922f35}
.section{
padding:clamp(54px,8vw,88px) clamp(20px,6vw,70px);
scroll-margin-top:82px;
}
.white{background:#fff}
.gray{background:#eef2f5}
.navy{background:var(--navy2);color:#fff}
.section-head{margin-bottom:34px}
.section-head.center{
max-width:820px;
margin-right:auto;
margin-left:auto;
text-align:center;
}
.section h2{
margin:7px 0 0;
color:var(--navy2);
font-family:Georgia,"Noto Serif KR",serif;
font-size:clamp(29px,5vw,43px);
line-height:1.3;
letter-spacing:-.035em;
}
.navy h2{color:#fff}
.lead{
max-width:780px;
margin:14px 0 0;
color:var(--muted);
font-size:14px;
line-height:2;
}
.center .lead{margin-right:auto;margin-left:auto}
.navy .lead{color:rgba(255,255,255,.63)}
.values{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:14px;
margin-top:42px;
}
.value{
padding:27px 22px;
background:#f4f7fa;
border-top:4px solid var(--blue);
}
.value:nth-child(3){border-top-color:var(--red)}
.value-no{
color:#bcc8d2;
font-size:31px;
font-weight:900;
}
.value h3{
margin:10px 0 6px;
color:var(--navy2);
font-size:19px;
}
.value p{
margin:0;
color:#687580;
font-size:13px;
}
.greeting{
display:grid;
grid-template-columns:minmax(230px,.75fr) minmax(280px,1.25fr);
gap:34px;
align-items:stretch;
}
.director-card{
position:relative;
min-height:420px;
overflow:hidden;
background:var(--navy);
}
.director-card img{
width:100%;
height:100%;
min-height:420px;
object-fit:cover;
object-position:center top;
filter:grayscale(.45) saturate(.45);
opacity:.72;
}
.director-caption{
position:absolute;
right:0;
bottom:0;
left:0;
padding:28px 22px 20px;
background:linear-gradient(transparent,rgba(7,27,47,.98));
color:#fff;
}
.director-caption small{
color:#a9c6da;
font-weight:900;
}
.director-caption strong{
display:block;
margin-top:4px;
font-size:22px;
}
.letter{
padding:clamp(26px,5vw,46px);
background:#fff;
border:1px solid var(--line);
}
.letter h3{
margin:0 0 20px;
color:var(--navy2);
font-family:Georgia,"Noto Serif KR",serif;
font-size:clamp(24px,4vw,35px);
line-height:1.4;
}
.letter p{
margin:0 0 16px;
color:#596773;
font-size:13px;
line-height:2;
}
.signature{
margin-top:28px;
text-align:right;
color:var(--navy2);
font-weight:900;
}
.faculty-grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:clamp(9px,2vw,16px);
}
.faculty{
display:grid;
grid-template-columns:minmax(110px,38%) 1fr;
min-height:225px;
overflow:hidden;
background:#fff;
color:var(--text);
}
.faculty img{
width:100%;
height:100%;
min-height:225px;
object-fit:cover;
object-position:center top;
filter:grayscale(.72) saturate(.52);
}
.faculty-info{padding:clamp(14px,3vw,22px)}
.faculty-role{
color:var(--blue);
font-size:9px;
font-weight:900;
letter-spacing:.1em;
}
.faculty h3{
margin:6px 0 1px;
font-size:clamp(17px,3vw,22px);
}
.faculty small{color:#77838d}
.faculty p{
margin:14px 0 0;
padding-top:12px;
border-top:1px solid #e1e6ea;
color:#596773;
font-size:11px;
}
.trainee-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:15px;
}
.trainee{
display:grid;
grid-template-columns:minmax(105px,38%) 1fr;
min-height:220px;
overflow:hidden;
background:#fff;
border:1px solid var(--line);
}
.trainee img{
width:100%;
height:100%;
object-fit:cover;
object-position:center top;
filter:saturate(.6);
}
.trainee-info{padding:18px 16px}
.trainee-no{
color:var(--blue);
font-size:10px;
font-weight:900;
}
.trainee h3{
margin:8px 0 0;
font-size:20px;
}
.trainee small{color:#84909a}
.charge{
margin-top:17px;
padding-top:11px;
border-top:1px solid #e1e6ea;
}
.charge span{
display:block;
color:#9aa4ac;
font-size:9px;
}
.charge b{font-size:12px}
.route-layout{
display:grid;
grid-template-columns:minmax(280px,1.1fr) minmax(260px,.9fr);
gap:22px;
}
.map{
position:relative;
min-height:430px;
overflow:hidden;
background:
linear-gradient(90deg,transparent 49%,rgba(16,46,74,.08) 50%,transparent 51%),
linear-gradient(transparent 49%,rgba(16,46,74,.08) 50%,transparent 51%),
#e2e8ec;
background-size:58px 58px;
border:1px solid #c8d3dc;
}
.road-h,.road-v{
position:absolute;
background:#fff;
box-shadow:0 0 0 1px #cfd8df;
}
.road-h{left:-5%;right:-5%;top:48%;height:64px;transform:rotate(-5deg)}
.road-v{top:-5%;bottom:-5%;left:28%;width:58px;transform:rotate(5deg)}
.river{
position:absolute;
right:-10%;
top:-12%;
width:42%;
height:130%;
background:#b8d0df;
transform:rotate(13deg);
opacity:.8;
}
.map-pin{
position:absolute;
left:52%;
top:42%;
width:130px;
padding:12px 10px;
transform:translate(-50%,-50%);
background:var(--navy2);
color:#fff;
text-align:center;
border:4px solid #fff;
box-shadow:0 7px 18px rgba(0,0,0,.2);
font-size:11px;
font-weight:900;
}
.map-pin:after{
content:"";
position:absolute;
left:50%;
bottom:-17px;
border:8px solid transparent;
border-top-color:var(--navy2);
transform:translateX(-50%);
}
.station{
position:absolute;
left:9%;
bottom:18%;
padding:7px 9px;
background:#fff;
border:1px solid #aebdc8;
color:var(--navy2);
font-size:10px;
font-weight:900;
}
.route-info{
display:flex;
flex-direction:column;
gap:12px;
}
.info-box{
padding:21px;
background:#fff;
border:1px solid var(--line);
}
.info-box h3{
margin:0 0 9px;
color:var(--navy2);
font-size:16px;
}
.info-box p,.info-box li{
color:#64727d;
font-size:12px;
line-height:1.85;
}
.info-box p{margin:0}
.info-box ul{margin:0;padding-left:18px}
.warning{
border-left:4px solid var(--red);
background:#fff5f5;
}
.form-shell{
background:#fff;
border:1px solid #cbd6de;
box-shadow:0 12px 40px rgba(18,46,72,.08);
}
.form-title{
padding:24px clamp(18px,4vw,34px);
background:var(--navy2);
color:#fff;
}
.form-title h3{margin:0;font-size:22px}
.form-title p{
margin:6px 0 0;
color:rgba(255,255,255,.63);
font-size:11px;
}
.form-body{padding:clamp(20px,5vw,40px)}
.form-grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:25px 22px;
}
.field.full{grid-column:1/-1}
.field label,.field-title{
display:block;
margin-bottom:9px;
color:var(--navy2);
font-size:13px;
font-weight:900;
}
.required{color:var(--red)}
.text-input,.text-area{
width:100%;
padding:12px 13px;
border:1px solid #bcc9d3;
border-radius:0;
background:#fff;
color:var(--text);
outline:none;
}
.text-input:focus,.text-area:focus{
border-color:var(--blue);
box-shadow:0 0 0 3px rgba(40,91,130,.1);
}
.text-area{
min-height:105px;
resize:vertical;
}
.options{
display:flex;
flex-wrap:wrap;
gap:7px;
}
.choice{position:relative}
.choice input{
position:absolute;
width:1px;
height:1px;
opacity:0;
}
.choice span{
display:block;
padding:8px 11px;
border:1px solid #c8d2da;
background:#f7f9fa;
color:#52616c;
font-size:11px;
font-weight:800;
cursor:pointer;
user-select:none;
}
.choice input:checked+span{
border-color:var(--blue);
background:var(--blue);
color:#fff;
}
.choice input:focus+span{
box-shadow:0 0 0 3px rgba(40,91,130,.16);
}
.custom-input{
display:none;
margin-top:9px;
}
.hint{
margin-top:7px;
color:#87939c;
font-size:10px;
}
.form-actions{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:9px;
margin-top:34px;
padding-top:25px;
border-top:1px solid #dfe5e9;
}
.btn{
min-width:135px;
padding:12px 18px;
border:1px solid var(--navy2);
background:var(--navy2);
color:#fff;
font-weight:900;
cursor:pointer;
}
.btn:hover{background:#1b496e}
.btn.secondary{
background:#fff;
color:var(--navy2);
}
.result{
display:none;
margin-top:25px;
border:2px solid var(--navy2);
background:#f7f9fa;
}
.result.open{display:block}
.result-head{
display:flex;
align-items:center;
justify-content:space-between;
gap:12px;
padding:15px 18px;
background:#dfe8ee;
border-bottom:1px solid #bfcbd4;
}
.result-head strong{color:var(--navy2)}
.result-body{padding:18px}
.result textarea{
width:100%;
min-height:350px;
padding:16px;
resize:vertical;
border:1px solid #bac7d1;
background:#fff;
color:#26323b;
font-family:"Noto Sans KR",sans-serif;
font-size:12px;
line-height:1.8;
}
.result-actions{
display:flex;
flex-wrap:wrap;
gap:8px;
margin-top:12px;
}
.agencies{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:15px;
}
.agency{
position:relative;
display:block;
padding:26px;
overflow:hidden;
background:#fff;
border:1px solid var(--line);
text-decoration:none;
}
.agency:after{
content:"↗";
position:absolute;
right:22px;
top:21px;
color:var(--blue);
font-size:20px;
font-weight:900;
}
.agency small{
color:var(--blue);
font-weight:900;
letter-spacing:.1em;
}
.agency h3{
margin:9px 0 5px;
color:var(--navy2);
font-size:20px;
}
.agency p{
margin:0;
padding-right:20px;
color:#687680;
font-size:11px;
word-break:break-all;
}
.agency:hover{
transform:translateY(-2px);
border-color:var(--blue);
box-shadow:0 10px 25px rgba(12,39,68,.1);
}
.footer{
padding:35px clamp(20px,5vw,56px);
background:#071b2d;
color:rgba(255,255,255,.43);
text-align:center;
font-size:9px;
line-height:1.9;
}
.toast{
position:fixed;
left:50%;
bottom:25px;
z-index:100;
max-width:calc(100% - 30px);
padding:12px 18px;
transform:translate(-50%,30px);
background:#091f36;
color:#fff;
box-shadow:0 8px 25px rgba(0,0,0,.28);
font-size:12px;
font-weight:800;
opacity:0;
pointer-events:none;
transition:.25s;
}
.toast.show{
transform:translate(-50%,0);
opacity:1;
}
@media(max-width:760px){
.topbar{display:none}
.header{
position:relative;
display:block;
padding:12px 14px 0;
}
.brand{margin-bottom:11px}
.nav{
justify-content:flex-start;
margin:0 -14px;
padding:0 14px 10px;
}
.hero{min-height:530px}
.quick{grid-template-columns:repeat(2,1fr)}
.quick a:nth-child(2){border-right:0}
.quick a:nth-child(-n+2){border-bottom:1px solid var(--line)}
.values{grid-template-columns:1fr}
.greeting,.route-layout{grid-template-columns:1fr}
.director-card,.director-card img{min-height:350px}
.form-grid{grid-template-columns:1fr}
.field.full{grid-column:auto}
.agencies{grid-template-columns:1fr}
}
@media(max-width:480px){
.faculty{
display:block;
min-height:0;
}
.faculty img{
height:170px;
min-height:170px;
}
.faculty-info{padding:13px}
.faculty p{font-size:10px}
.trainee{grid-template-columns:105px 1fr}
.choice span{padding:7px 9px;font-size:10px}
}
</style>
</head>

<body>
<div class="site">
